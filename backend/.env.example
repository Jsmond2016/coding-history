# 数据库配置
# SQLite 数据库文件路径。注意：相对路径是相对于 backend/prisma/ 目录解析的（即 schema 所在目录）。
# 推荐：数据库放在 backend/database/ 下，使用：
DATABASE_URL="file:./database/coding-history.db"

# 日志级别（可选）
# 可选值: trace, debug, info, warn, error, fatal
LOG_LEVEL="info"

ENABLE_STARTUP_SCAN=false

# 数据库文件定时备份（系统级，仅写备份文件与日志）
# Cron：分 时 日 月 星期；默认每周五 19:00。留空、false、off、0 表示关闭
DB_BACKUP_CRON="0 19 * * 5"
# 备份目录（可改；默认如下）
DB_BACKUP_DIR="/Users/huangjing/Desktop/MyCode/temp/coding-history-db-backup"