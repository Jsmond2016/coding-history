{
  "name": "coding-history-app",
  "version": "1.0.0",
  "private": true,
  "description": "Git commit statistics application",
  "pnpm": {
    "overrides": {
      "tslib": "^2.6.0"
    }
  },
  "volta": {
    "node": "20.19.6",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "dev": "ENABLE_STARTUP_SCAN=false pnpm --filter coding-history-backend --filter coding-history-frontend run --parallel dev",
    "dev:backend": "pnpm --filter coding-history-backend dev",
    "dev:frontend": "pnpm --filter coding-history-frontend dev",
    "build:backend": "pnpm --filter coding-history-backend build",
    "build:frontend": "pnpm --filter coding-history-frontend build",
    "init-scan": "pnpm --filter coding-history-backend init-scan",
    "start": "pnpm exec pm2 start ecosystem.config.cjs",
    "stop": "pnpm exec pm2 stop ecosystem.config.cjs",
    "restart": "pnpm exec pm2 restart ecosystem.config.cjs",
    "delete": "pnpm exec pm2 delete ecosystem.config.cjs",
    "logs": "pnpm exec pm2 logs",
    "status": "pnpm exec pm2 status",
    "reset": "pnpm exec pm2 kill"
  },
  "devDependencies": {
    "pm2": "^6.0.14"
  }
}
