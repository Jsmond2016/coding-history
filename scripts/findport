#!/bin/bash

# findport - 查找占用指定端口的进程
# 使用方法: findport <端口号>

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 检查参数
if [ -z "$1" ]; then
    echo -e "${RED}错误: 请提供端口号${NC}"
    echo -e "${YELLOW}使用方法: findport <端口号>${NC}"
    echo -e "${YELLOW}示例: findport 5188${NC}"
    exit 1
fi

PORT=$1

# 验证端口号是否为数字
if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}错误: 端口号必须是数字${NC}"
    exit 1
fi

# 验证端口号范围
if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    echo -e "${RED}错误: 端口号必须在 1-65535 之间${NC}"
    exit 1
fi

echo -e "${BLUE}正在查找占用端口 ${GREEN}${PORT}${BLUE} 的进程...${NC}"
echo ""

# 使用 lsof 查找端口占用情况 (macOS)
RESULT=$(lsof -i :$PORT -P -n 2>/dev/null)

if [ -z "$RESULT" ]; then
    echo -e "${YELLOW}未找到占用端口 ${PORT} 的进程${NC}"
    exit 0
fi

# 格式化输出
echo -e "${GREEN}找到以下进程:${NC}"
echo ""
echo "$RESULT" | head -1 | awk '{printf "%-10s %-8s %-8s %-8s %-20s %s\n", $1, $2, $3, $8, $9, $10}'
echo "--------------------------------------------------------------------------------"
echo "$RESULT" | tail -n +2 | awk '{printf "%-10s %-8s %-8s %-8s %-20s %s\n", $1, $2, $3, $8, $9, $10}'
echo ""

# 统计进程数量
COUNT=$(echo "$RESULT" | tail -n +2 | wc -l | tr -d ' ')
echo -e "${BLUE}共找到 ${GREEN}${COUNT}${BLUE} 个进程占用端口 ${GREEN}${PORT}${NC}"
echo ""

# 显示详细信息
echo -e "${YELLOW}提示: 使用 'killport ${PORT}' 可以关闭这些进程${NC}"

